{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kmephis-ai/PrihRashOnline-v2/.ai-context/roadmap-task-packet.schema.json",
  "title": "PrihRashOnline Roadmap Task Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "action",
    "roadmap_id",
    "issue",
    "work_class",
    "engineering_status",
    "product_stage",
    "target_stage",
    "goal",
    "non_goals",
    "dependencies",
    "data_touched",
    "privacy_class",
    "cost_class",
    "acceptance",
    "evidence_required",
    "rollback",
    "blocking_product_gate",
    "branch",
    "pr_close_line",
    "required_delivery_gates",
    "one_active_writer"
  ],
  "properties": {
    "schema": { "const": "PRH_ROADMAP_TASK_V2" },
    "action": { "enum": ["START_READY", "CONTINUE_ACTIVE"] },
    "roadmap_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{3}$" },
    "issue": { "type": "integer", "minimum": 1 },
    "work_class": { "enum": ["engineering", "user_facing"] },
    "engineering_status": { "enum": ["BACKLOG", "IN_PROGRESS", "CODE_COMPLETE", "DONE_ENGINEERING"] },
    "product_stage": {
      "enum": ["NOT_APPLICABLE", "NOT_STARTED", "CODE_COMPLETE", "RUNTIME_INTEGRATED", "REAL_E2E_VERIFIED", "PRODUCT_READY", "DONE"]
    },
    "target_stage": { "enum": ["DONE_ENGINEERING", "DONE"] },
    "goal": { "type": "string", "minLength": 1 },
    "non_goals": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["roadmap_id", "status", "product_stage", "required_stage"],
        "properties": {
          "roadmap_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{3}$" },
          "status": { "enum": ["IN_PROGRESS", "BLOCKED", "DONE"] },
          "issue": { "type": ["integer", "null"], "minimum": 1 },
          "product_stage": {
            "enum": ["NOT_APPLICABLE", "NOT_STARTED", "CODE_COMPLETE", "RUNTIME_INTEGRATED", "REAL_E2E_VERIFIED", "PRODUCT_READY", "DONE"]
          },
          "required_stage": { "enum": ["DONE_ENGINEERING", "RUNTIME_INTEGRATED", "PRODUCT_READY"] }
        }
      }
    },
    "data_touched": { "type": "string", "minLength": 1 },
    "privacy_class": { "type": "string", "minLength": 1 },
    "cost_class": { "const": "FREE_ONLY" },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "evidence_required": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "rollback": { "type": "string", "minLength": 1 },
    "blocking_product_gate": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "pattern": "^agent/[A-Z][A-Z0-9-]*-[0-9]{3}-[a-z0-9][a-z0-9-]*$" },
    "pr_close_line": { "type": "string", "pattern": "^Closes #[1-9][0-9]*$" },
    "required_delivery_gates": {
      "oneOf": [
        {
          "const": [
            "PR_VALIDATION",
            "TRUSTED_DEV_DEPLOY",
            "TRUSTED_RUNTIME_HEALTH",
            "AUTONOMOUS_MERGE",
            "MAIN_VERIFICATION"
          ]
        },
        {
          "const": [
            "PR_VALIDATION",
            "TRUSTED_DEV_DEPLOY",
            "TRUSTED_RUNTIME_HEALTH",
            "AUTONOMOUS_MERGE",
            "MAIN_VERIFICATION",
            "PRODUCT_READY_E2E"
          ]
        }
      ]
    },
    "one_active_writer": { "const": true }
  }
}
