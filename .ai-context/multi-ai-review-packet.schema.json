{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kmephis-ai/PrihRashOnline-v2/.ai-context/multi-ai-review-packet.schema.json",
  "title": "PrihRashOnline Multi-AI Review Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "roadmap_id", "issue", "pr", "candidate_sha",
    "review_mode", "writer_authority", "required_roles",
    "changed_paths", "public_evidence_refs"
  ],
  "properties": {
    "schema": { "const": "PRH_MULTI_AI_REVIEW_PACKET_V1" },
    "roadmap_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{3}$" },
    "issue": { "type": "integer", "minimum": 1 },
    "pr": { "type": "integer", "minimum": 1 },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "review_mode": { "const": "READ_ONLY" },
    "writer_authority": { "const": false },
    "required_roles": {
      "const": ["ARCHITECTURE", "SECURITY_PRIVACY", "FINANCIAL_DATA", "TEST_OPERATIONS"]
    },
    "changed_paths": {
      "type": "array", "minItems": 1, "maxItems": 500, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "public_evidence_refs": {
      "type": "array", "maxItems": 200, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    }
  }
}
