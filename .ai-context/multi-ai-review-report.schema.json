{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kmephis-ai/PrihRashOnline-v2/.ai-context/multi-ai-review-report.schema.json",
  "title": "PrihRashOnline Multi-AI Reviewer Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "roadmap_id", "issue", "pr", "candidate_sha",
    "reviewer_id", "role", "review_mode", "writer_authority", "findings"
  ],
  "properties": {
    "schema": { "const": "PRH_MULTI_AI_REVIEW_REPORT_V1" },
    "roadmap_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*-[0-9]{3}$" },
    "issue": { "type": "integer", "minimum": 1 },
    "pr": { "type": "integer", "minimum": 1 },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "reviewer_id": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{2,64}$" },
    "role": { "enum": ["ARCHITECTURE", "SECURITY_PRIVACY", "FINANCIAL_DATA", "TEST_OPERATIONS"] },
    "review_mode": { "const": "READ_ONLY" },
    "writer_authority": { "const": false },
    "findings": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["severity", "code", "path", "summary", "recommendation", "confidence", "resolved"],
        "properties": {
          "severity": { "enum": ["P0", "P1", "P2", "P3"] },
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
          "path": { "type": "string", "minLength": 1, "maxLength": 240 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 240 },
          "recommendation": { "type": "string", "minLength": 1, "maxLength": 500 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "resolved": { "type": "boolean" }
        }
      }
    }
  }
}
