{
  "schema": "PRH_SLO_CONTRACT_V1",
  "version": "1.0.0",
  "roadmap_id": "OBS-010",
  "free_only": true,
  "external_provider_required": false,
  "financial_payload_allowed": false,
  "observation_fields": [
    "sli_id",
    "ok",
    "duration_ms",
    "observed_at_ms",
    "evaluated_at_ms",
    "error_count",
    "checked_count",
    "source"
  ],
  "technical_code_pattern": "^[A-Z][A-Z0-9_:-]{0,95}$",
  "slis": [
    {
      "id": "availability",
      "kind": "boolean_good",
      "objective": 0.995,
      "min_samples": 5
    },
    {
      "id": "latency",
      "kind": "duration_threshold",
      "objective": 0.95,
      "threshold_ms": 1500,
      "min_samples": 5
    },
    {
      "id": "correctness",
      "kind": "boolean_good",
      "objective": 1,
      "min_samples": 1,
      "allowed_sources": [
        "FINANCIAL_RECONCILIATION",
        "CANONICAL_SCHEMA",
        "ANALYTICS_PARITY",
        "MIGRATION_RECONCILIATION",
        "RUNTIME_HEALTH"
      ]
    },
    {
      "id": "freshness",
      "kind": "age_threshold",
      "objective": 0.99,
      "threshold_ms": 900000,
      "min_samples": 5
    },
    {
      "id": "migration_errors",
      "kind": "error_ratio",
      "objective": 1,
      "min_samples": 1
    }
  ],
  "states": ["PASS", "DEGRADED", "EXHAUSTED", "INSUFFICIENT_DATA", "UNKNOWN"],
  "aggregate_states": ["PASS", "WARN", "FAIL"],
  "privacy": {
    "public_evidence": "TECHNICAL_METADATA_ONLY",
    "forbidden_payload_examples": [
      "amount",
      "income",
      "expense",
      "balance",
      "description",
      "category",
      "account",
      "transaction",
      "payload"
    ]
  }
}
