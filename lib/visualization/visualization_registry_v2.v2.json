{
  "schema": "PRH_VISUALIZATION_REGISTRY_V2",
  "version": "2.0.0",
  "roadmap_id": "VIZ-070",
  "upstream": {
    "visualization_foundation": "PRH_VISUALIZATION_FOUNDATION_V1@1.0.0",
    "exploration_state": "PRH_EXPLORATION_STATE_V1@1.0.0",
    "analytics_contract": "PRH_ANALYTICS_CONTRACT_V1@1.0.0",
    "financial_truth_policy": "FIN-TRUTH-v1"
  },
  "schemas": {
    "plan": "PRH_VISUALIZATION_PLAN_V2",
    "retype_result": "PRH_VISUALIZATION_RETYPE_RESULT_V2"
  },
  "principles": {
    "registry_configuration_only": true,
    "query_mutation_allowed": false,
    "financial_formula_allowed": false,
    "renderer_owns_financial_truth": false,
    "renderer_owns_query_semantics": false,
    "advanced_chart_pack_in_scope": false,
    "external_cdn_required": false,
    "paid_dependency_required": false,
    "free_only": true
  },
  "renderers": {
    "ECHARTS_6": {
      "family": "Apache ECharts",
      "major": 6,
      "primary_browser": true,
      "replaceable": true,
      "loading_policy": "LOCAL_OR_BUNDLED",
      "supports_interaction": true,
      "supports_animation": true,
      "accessible_fallback": "SEMANTIC_TABLE_V1",
      "network_authority": false,
      "storage_authority": false,
      "financial_truth_authority": false,
      "query_authority": false
    },
    "SEMANTIC_TABLE_V1": {
      "family": "Semantic HTML table",
      "major": 1,
      "primary_browser": false,
      "replaceable": true,
      "loading_policy": "BUILT_IN",
      "supports_interaction": false,
      "supports_animation": false,
      "accessible_fallback": null,
      "network_authority": false,
      "storage_authority": false,
      "financial_truth_authority": false,
      "query_authority": false
    }
  },
  "chart_registry": {
    "BAR": {
      "foundation_type": "BAR",
      "renderer": "ECHARTS_6",
      "required_roles": ["x", "y"],
      "optional_roles": ["series"],
      "role_kinds": {"x":["DIMENSION"],"y":["MEASURE"],"series":["DIMENSION"]},
      "responsive": {"mobile":"HORIZONTAL_SCROLL_OR_REDUCE_LABEL_DENSITY","tablet":"REDUCE_LABEL_DENSITY","desktop":"STANDARD"},
      "a11y": {"semantic_table_required":true,"text_summary_required":true,"interaction_only_evidence_allowed":false},
      "supports_filter_selection": true,
      "supports_drill": true
    },
    "LINE": {
      "foundation_type": "LINE",
      "renderer": "ECHARTS_6",
      "required_roles": ["x", "y"],
      "optional_roles": ["series"],
      "role_kinds": {"x":["DIMENSION"],"y":["MEASURE"],"series":["DIMENSION"]},
      "responsive": {"mobile":"REDUCE_LABEL_DENSITY","tablet":"REDUCE_LABEL_DENSITY","desktop":"STANDARD"},
      "a11y": {"semantic_table_required":true,"text_summary_required":true,"interaction_only_evidence_allowed":false},
      "supports_filter_selection": true,
      "supports_drill": true
    },
    "DONUT": {
      "foundation_type": "DONUT",
      "renderer": "ECHARTS_6",
      "required_roles": ["category", "value"],
      "optional_roles": [],
      "role_kinds": {"category":["DIMENSION"],"value":["MEASURE"]},
      "responsive": {"mobile":"LEGEND_BELOW","tablet":"LEGEND_BELOW","desktop":"STANDARD"},
      "a11y": {"semantic_table_required":true,"text_summary_required":true,"interaction_only_evidence_allowed":false},
      "supports_filter_selection": true,
      "supports_drill": true
    }
  },
  "retype_rules": [
    {"from":"BAR","to":"LINE","mapping":{"x":"x","y":"y","series":"series"},"requires_no_series":false},
    {"from":"LINE","to":"BAR","mapping":{"x":"x","y":"y","series":"series"},"requires_no_series":false},
    {"from":"BAR","to":"DONUT","mapping":{"category":"x","value":"y"},"requires_no_series":true},
    {"from":"LINE","to":"DONUT","mapping":{"category":"x","value":"y"},"requires_no_series":true},
    {"from":"DONUT","to":"BAR","mapping":{"x":"category","y":"value"},"requires_no_series":false},
    {"from":"DONUT","to":"LINE","mapping":{"x":"category","y":"value"},"requires_no_series":false}
  ],
  "responsive_breakpoints": {
    "mobile_max_width_px": 479,
    "tablet_max_width_px": 1023,
    "min_width_px": 240,
    "max_width_px": 8192
  },
  "telemetry_allowlist": [
    "schema",
    "version",
    "chart_type",
    "renderer",
    "responsive_mode",
    "responsive_strategy",
    "semantic_table_required",
    "text_summary_required",
    "query_hash_prefix",
    "query_modified",
    "decision",
    "reason"
  ],
  "authorities": {
    "query": false,
    "financial_truth": false,
    "financial_write": false,
    "storage": false,
    "network": false,
    "persistence": false
  }
}
