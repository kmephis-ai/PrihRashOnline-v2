{
  "schema": "PRH_TRANSACTION_REPOSITORY_V1",
  "version": "1.0.0",
  "entity_schema": "PRH_CANONICAL_TRANSACTION_V1@1",
  "capabilities": {
    "read": true,
    "query": true,
    "write_interface": true
  },
  "query": {
    "max_limit": 500,
    "default_limit": 100,
    "order": "occurred_at ASC, transaction_id ASC",
    "filters": [
      "transaction_ids", "types", "statuses", "currency",
      "account_id", "category_id", "member_id", "project_id", "tags_any",
      "period_start", "period_end"
    ],
    "period_bounds": "START_INCLUSIVE_END_EXCLUSIVE"
  },
  "write": {
    "max_batch": 100,
    "required_fields": ["idempotency_key", "expected_revision", "operations"],
    "operation_actions": ["PUT"],
    "production_authority": "EXPLICIT_FINANCIAL_MUTATION_POLICY_REQUIRED",
    "google_adapter_default": "BLOCKED_WRITE_POLICY_REQUIRED"
  },
  "result": {
    "revision": "sha256 canonical public-safe structure/content identity inside private process",
    "errors": "BOUNDED_REASON_CODE_ONLY"
  }
}
