{
  "schema": "PRH_SINGLE_SCAN_REFRESH_V1",
  "version": "1.0.0",
  "roadmap_id": "PERF-012",
  "repository_contract": "PRH_TRANSACTION_REPOSITORY_V1@1.0.0",
  "canonical_schema": "PRH_CANONICAL_TRANSACTION_V1@1",
  "analytics_contract": "PRH_ANALYTICS_CONTRACT_V1@1.0.0",
  "snapshot": {
    "source": "READ_ALL_ONCE_PER_CYCLE",
    "revision_strategy": "DERIVE_FROM_VALIDATED_CANONICAL_SNAPSHOT",
    "revision_algorithm": "PRH_TRANSACTION_REPOSITORY_V1.repositoryRevision",
    "immutable": true,
    "cross_cycle_reuse": false,
    "unknown_revision": "FAIL_CLOSED",
    "expired_snapshot": "FAIL_CLOSED",
    "invalidated_snapshot": "FAIL_CLOSED"
  },
  "bounds": {
    "default_max_age_ms": 30000,
    "max_age_ms": 300000,
    "default_max_operations": 64,
    "max_operations": 512
  },
  "execution": {
    "operations": ["READ_ALL", "GET_BY_ID", "QUERY", "ANALYTICS"],
    "canonical_snapshot_reads_per_cycle": 1,
    "underlying_get_revision_calls": 0,
    "underlying_get_by_id_calls": 0,
    "underlying_query_calls": 0,
    "query_semantic_authority": "PRH_TRANSACTION_REPOSITORY_V1.applyQuery",
    "analytics_semantic_authority": "PRH_ANALYTICS_CONTRACT_V1.evaluateAnalytics",
    "snapshot_revision_provenance_required": true
  },
  "telemetry": {
    "financial_payload_allowed": false,
    "raw_query_allowed": false,
    "transaction_identity_allowed": false,
    "fields": [
      "snapshot_status",
      "reason_code",
      "cycle_hash",
      "revision_token_hash_prefix",
      "canonical_snapshot_read_count",
      "logical_operation_count",
      "snapshot_reuse_count",
      "read_all_count",
      "get_by_id_count",
      "query_count",
      "analytics_count",
      "invalidation_count",
      "age_ms",
      "max_age_ms",
      "max_operations"
    ]
  },
  "compatibility": {
    "perf010_projection_semantics_preserved": true,
    "perf011_cache_semantics_preserved": true,
    "single_cycle_point_in_time_snapshot": true,
    "new_cycle_requires_new_canonical_snapshot_read": true
  },
  "authority": {
    "financial_semantics": false,
    "financial_write": false,
    "migration": false,
    "network": false,
    "external_provider_required": false,
    "paid_dependency_required": false
  }
}
