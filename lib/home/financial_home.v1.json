{
  "schema": "PRH_FINANCIAL_HOME_V1",
  "version": "1.0.0",
  "roadmap_id": "HOME-020",
  "upstream": {
    "financial_truth": "FIN-TRUTH-v1",
    "kpi_dictionary": "PRH_KPI_DICTIONARY_V1@1.0.0",
    "visualization": "PRH_VISUALIZATION_FOUNDATION_V1@1.0.0",
    "design_system": "PRH_DESIGN_SYSTEM_V1@1.0.0"
  },
  "view_model": {
    "schema": "PRH_FINANCIAL_HOME_VIEW_V1",
    "money_representation": "integer_minor_units",
    "cards": ["INCOME", "EXPENSE", "CASH_FLOW", "SAVINGS", "BUDGET", "LIQUIDITY", "ALERTS"],
    "card_states": ["READY", "NOT_CONFIGURED", "UNAVAILABLE_PENDING_BALANCE_SOURCE"],
    "financial_values_source": "SINGLE_FIN010_EVALUATION"
  },
  "budget": {
    "input": "EXPLICIT_BUDGET_MINOR",
    "scope": "SAME_EXPLICIT_PERIOD_AND_CURRENCY",
    "missing_state": "NOT_CONFIGURED",
    "implicit_plan_allowed": false
  },
  "liquidity": {
    "source_required": "VERSIONED_BALANCE_OBSERVATION",
    "current_source": null,
    "current_state": "UNAVAILABLE_PENDING_BALANCE_SOURCE",
    "cash_flow_proxy_allowed": false,
    "future_dependency": "BAL-030"
  },
  "alerts": [
    {
      "code": "NEGATIVE_CASH_FLOW",
      "severity": "WARNING",
      "source_kpi": "CASH_FLOW",
      "predicate": "cash_flow_minor < 0",
      "drill_target": "TRANSACTION_EXPLORER"
    },
    {
      "code": "BUDGET_OVERRUN",
      "severity": "WARNING",
      "source_kpi": "BUDGET_VARIANCE",
      "predicate": "budget_variance_minor < 0",
      "requires_budget": true,
      "drill_target": "TRANSACTION_EXPLORER"
    },
    {
      "code": "BUDGET_NOT_CONFIGURED",
      "severity": "INFO",
      "source_capability": "BUDGET",
      "predicate": "budget_variance_minor == null",
      "drill_target": "DETAILS"
    },
    {
      "code": "LIQUIDITY_SOURCE_UNAVAILABLE",
      "severity": "INFO",
      "source_capability": "LIQUIDITY",
      "predicate": "balance_observation_source == null",
      "drill_target": "DETAILS"
    }
  ],
  "visualizations": [
    {
      "widget_id": "home-cash-flow-trend",
      "query_ref": "HOME:CASH_FLOW:TREND",
      "chart_type": "LINE",
      "x": { "kind": "DIMENSION", "id": "time_bucket" },
      "y": { "kind": "MEASURE", "id": "CASH_FLOW" }
    },
    {
      "widget_id": "home-expense-mix",
      "query_ref": "HOME:EXPENSE:MIX",
      "chart_type": "DONUT",
      "category": { "kind": "DIMENSION", "id": "category_id" },
      "value": { "kind": "MEASURE", "id": "EXPENSE" }
    }
  ],
  "interaction": {
    "filter_context": "PRH_FILTER_CONTEXT_V1",
    "drill_context": "PRH_DRILL_CONTEXT_V1",
    "period_preservation": "HOME_DRILL_ENVELOPE_EXPLICIT_FIN010_PERIOD",
    "financial_payload_in_navigation_state_allowed": false
  },
  "privacy": {
    "public_finance_evidence": "SYNTHETIC_ONLY",
    "real_view_model_public": false,
    "real_render_data_public": false,
    "private_runtime_locator_public": false
  },
  "cost": {
    "class": "FREE_ONLY",
    "paid_dependency_required": false,
    "external_cdn_required": false
  },
  "authorities": {
    "financial_truth": false,
    "query": false,
    "storage": false,
    "network": false,
    "financial_write": false,
    "balance_observation": false
  }
}