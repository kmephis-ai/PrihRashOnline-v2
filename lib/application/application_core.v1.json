{
  "schema": "PRH_APPLICATION_CORE_V1",
  "version": "1.0.0",
  "runtime_model": "PURE_IN_PROCESS",
  "inputs": "PLAIN_DOMAIN_DATA",
  "outputs": "PLAIN_DOMAIN_DATA",
  "io_authority": false,
  "financial_write_authority": false,
  "network_authority": false,
  "required_dependencies": {
    "financial_truth": "FIN-TRUTH-v1",
    "kpi_dictionary": "PRH_KPI_DICTIONARY_V1@1.0.0",
    "canonical_transaction": "PRH_CANONICAL_TRANSACTION_V1@1",
    "migration_transform": "SOURCE-TRANSFORM-v1"
  },
  "use_cases": {
    "VALIDATE_CANONICAL_DATASET": {
      "input": "canonical_transactions[]",
      "output": "PRH_DATASET_VALIDATION_RESULT_V1"
    },
    "CALCULATE_FINANCIAL_SNAPSHOT": {
      "input": "canonical_transactions[] + kpi_options",
      "output": "PRH_FINANCIAL_SNAPSHOT_V1"
    },
    "REVIEW_MIGRATION": {
      "input": "source_records[] + migration_compatible_canonical_transactions[]",
      "output": "DATA-001 reconciliation result"
    },
    "PLAN_IDEMPOTENT_IMPORT": {
      "input": "source_records[] + migration_compatible_canonical_transactions[]",
      "output": "DATA-001 idempotent import plan"
    }
  },
  "forbidden_dependencies": [
    "SpreadsheetApp",
    "UrlFetchApp",
    "HtmlService",
    "PropertiesService",
    "LockService",
    "CacheService",
    "DriveApp",
    "DocumentApp",
    "FormApp",
    "window",
    "document",
    "localStorage",
    "fetch"
  ],
  "dependency_boundary": {
    "allowed_project_roots": ["lib/domain", "lib/finance", "lib/migration", "lib/application"],
    "allowed_node_builtins": ["crypto"],
    "apps_script_modules": "FORBIDDEN",
    "ui_modules": "FORBIDDEN"
  }
}
