{
  "schema": "PRH_FULL_HISTORY_MIGRATION_V1",
  "version": "1.0.0",
  "source_contract": "SOURCE-TRANSFORM-v1",
  "target_contract": "PRH_CANONICAL_TRANSACTION_V1@1",
  "repository_contract": "PRH_TRANSACTION_REPOSITORY_V1@1.0.0",
  "mode": "OWNER_PRIVATE_POLICY_GATED",
  "batch": {
    "max_size": 100,
    "order": "source_fingerprint ASC",
    "idempotency": "MIG010:<plan_hash>:<batch_index>",
    "expected_revision_required": true
  },
  "resume": {
    "schema": "PRH_MIGRATION_RESUME_V1",
    "integrity": "HMAC-SHA256",
    "binds": ["plan_hash", "next_batch", "expected_revision"]
  },
  "pre_write": {
    "authorization": "IRREVERSIBLE_ACTION_AUTHORIZED",
    "backup_schema": "DR-001-EVIDENCE-v1",
    "backup_status": "PASS",
    "backup_checksum": "PASS",
    "backup_max_age_ms": 86400000,
    "public_ci_can_authorize_real_write": false
  },
  "reconciliation": {
    "required_status": "PASS",
    "required_unexplained_mismatch": 0,
    "rerun": "IDEMPOTENT_REUSE_ONLY"
  },
  "public_evidence_allowlist": [
    "schema",
    "status",
    "planHash",
    "sourceRevisionHash",
    "initialTargetRevisionHash",
    "finalTargetRevisionHash",
    "backupCipherSha256",
    "unexplainedMismatch",
    "durationMs"
  ]
}
