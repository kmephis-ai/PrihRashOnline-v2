{
  "schema": "MIG010_EXECUTION_POLICY_V1",
  "version": "1.0.0",
  "strategy": "STAGE_VERIFY_REPLACE_WITH_ROLLBACK_V1",
  "authorization": "IRREVERSIBLE_ACTION_AUTHORIZED",
  "backup": {
    "required_schema": "DR-001-EVIDENCE-v1",
    "required_status": "PASS",
    "required_checksum": "PASS",
    "max_age_ms": 86400000,
    "exact_cipher_hash_binding": true
  },
  "binding": {
    "resolved_hash": true,
    "candidate_revision_hash": true,
    "initial_target_revision_hash": true,
    "initial_raw_table_hash": true,
    "final_raw_table_hash": true,
    "package_hash": true
  },
  "batch": {
    "max_rows": 100,
    "strict_sequential": true,
    "idempotency": "PACKAGE_HASH_PLUS_BATCH_INDEX",
    "readback_required": true
  },
  "mutation": {
    "direct_live_write_before_stage_verify": false,
    "rollback_copy_required": true,
    "staging_sheet_required": true,
    "live_replace_after_stage_verify_only": true,
    "rollback_on_finalize_failure": true,
    "keep_rollback_until_owner_reconciliation": true
  },
  "privacy": {
    "package_owner_private": true,
    "financial_payload_stdout": false,
    "public_ci_real_data": false
  },
  "public_ci_can_authorize_real_write": false,
  "write_authority_default": false
}
