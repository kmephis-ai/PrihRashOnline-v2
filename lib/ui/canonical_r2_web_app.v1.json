{
  "schema": "PRH_CANONICAL_R2_WEB_APP_V1",
  "version": "1.1.0",
  "roadmap_id": "UI-REC-001",
  "default_route": "home",
  "private_exposure": "MYSELF",
  "primary_navigation": ["home", "studio"],
  "secondary_navigation": ["legacy"],
  "hidden_unbound_routes": [
    "transactions",
    "expenses",
    "income",
    "cash-flow",
    "budget",
    "obligations",
    "data-quality"
  ],
  "navigation_policy": "PROVEN_DESTINATIONS_ONLY",
  "navigation_link_mode": "RUNTIME_SELF_URL_ABSOLUTE_WITH_TEST_FALLBACK",
  "home_data_delivery": {
    "mode": "ASYNC_GOOGLE_SCRIPT_RUN",
    "initial_html_financial_read": false,
    "runtime_function": "prhR2FetchFinancialHomePayload",
    "allowed_privacy_modes": ["NORMAL", "MASKED"],
    "loading_state_required": true,
    "retry_state_required": true,
    "financial_write": false
  },
  "runtime_bindings": {
    "home": {
      "state": "BOUND_READ_ONLY",
      "navigation": "PRIMARY",
      "surface": "FinancialHomeWebApp",
      "data_source": "PRH_R2_FIN_RUNTIME_BRIDGE_V1",
      "canonical_runtime": "PRH_R2_CANONICAL_RUNTIME_BUNDLE_V1",
      "financial_truth": "FIN-TRUTH-v1",
      "kpi_dictionary": "PRH_KPI_DICTIONARY_V1@1.0.0",
      "generated_from_canonical_lib": true,
      "financial_formula_copy": false,
      "parity_gate_required": true
    },
    "studio": {"state":"CONFIGURATION_ONLY","navigation":"PRIMARY","runtime_private_data":false,"surface":"AnalyticsStudioWebApp"},
    "legacy": {"state":"BOUND_READ_ONLY","navigation":"SECONDARY","runtime_private_data":true,"surface":"LEGACY_DASHBOARD"},
    "transactions": {"state":"SAFE_UNBOUND_FAIL_CLOSED","navigation":"HIDDEN","surface":"TransactionExplorerWebApp"},
    "expenses": {"state":"SAFE_UNBOUND_FAIL_CLOSED","navigation":"HIDDEN","surface":"ExpenseAnalyticsWebApp"},
    "income": {"state":"SAFE_UNBOUND_FAIL_CLOSED","navigation":"HIDDEN","surface":"IncomeAnalyticsWebApp"},
    "cash-flow": {"state":"SAFE_UNBOUND_FAIL_CLOSED","navigation":"HIDDEN","surface":"CashFlowWebApp"},
    "budget": {"state":"SAFE_UNBOUND_FAIL_CLOSED","navigation":"HIDDEN","surface":"BudgetControlWebApp"},
    "obligations": {"state":"SAFE_UNBOUND_FAIL_CLOSED","navigation":"HIDDEN","surface":"ObligationsWebApp"},
    "data-quality": {"state":"SAFE_UNBOUND_FAIL_CLOSED","navigation":"HIDDEN","surface":"DataQualityWebApp"}
  },
  "household_presentation": {
    "language": "ru",
    "raw_machine_ids_visible": false,
    "unproven_actions_visible": false,
    "developer_reason_codes_visible": false,
    "one_period_trend_behavior": "SEMANTIC_INSUFFICIENT_HISTORY_FALLBACK",
    "fake_drill_affordances_allowed": false
  },
  "synthetic_policy": {
    "browser_visual_fixture_allowed": true,
    "private_runtime_fallback_allowed": false,
    "unproven_binding_behavior": "FAIL_CLOSED_NO_SYNTHETIC_TRUTH"
  },
  "legacy_rollback": {
    "route": "legacy",
    "default": false,
    "bounded_until_post_cutover_verification": true,
    "financial_authority": false
  },
  "runtime_fin_adapter": {
    "schema": "PRH_R2_FIN_RUNTIME_BRIDGE_V1",
    "canonical_runtime_schema": "PRH_R2_CANONICAL_RUNTIME_BUNDLE_V1",
    "generated_candidate_file": "R2CanonicalRuntimeBundle.js",
    "canonical_sources": [
      "lib/adapters/google_sheets_transaction_repository.js",
      "lib/finance/financial_reconciliation.js",
      "lib/finance/kpi_dictionary.js",
      "lib/home/financial_home.js"
    ],
    "source": "01 Операции",
    "currency_setting": "09 Настройки:currency",
    "read_gateway": "prhGoogleRepositoryReadOperationsTable_",
    "dimension_resolver": {
      "schema": "PRH_RUNTIME_DIMENSION_LABEL_HASH_V1",
      "version": "1.1.0",
      "normalization": "TRIM_COLLAPSE_WHITESPACE_LOWERCASE",
      "identity": "KIND_SCOPED_SHA256_OF_NORMALIZED_LABEL",
      "private_reverse_label_projection": true,
      "persistent_identity_authority": false,
      "write_authority": false,
      "collision_behavior": "FAIL_CLOSED"
    },
    "money": "integer_minor_units",
    "financial_truth": "FIN-TRUTH-v1",
    "kpi_dictionary": "PRH_KPI_DICTIONARY_V1@1.0.0",
    "generated_from_canonical_lib": true,
    "financial_formula_copy": false,
    "legacy_total_cells_used": false,
    "ui_financial_formula_authority": false,
    "write_authority": false
  },
  "trusted_delivery": {
    "render_smoke_token": "PRH_WEBAPP_SMOKE_V4|R2|OK",
    "private_home_read_smoke_token": "PRH_R2_HOME_READ_V3|CANONICAL_LIB|DIMENSION_HASH|OK|7",
    "runtime_failure_reason_prefix": "RUNTIME_HEALTH_HOME_",
    "runtime_failure_reason_private_payload": false,
    "render_smoke_reads_financial_rows": false,
    "exact_sha_required": true,
    "runtime_health_required": true,
    "product_ready_e2e_required": true,
    "autonomous_merge_required": true,
    "manual_merge": false
  },
  "observability": {
    "public_allowlist": ["schema","version","route","surface","binding_state","render_status","reason_code","latency_ms"],
    "financial_payload_allowed": false,
    "private_runtime_locator_allowed": false
  },
  "authority": {
    "financial_truth": false,
    "canonical_transaction": false,
    "persistent_dimension_identity": false,
    "storage": false,
    "financial_write": false,
    "runtime_write": false,
    "deployment": false
  },
  "cost": {
    "class": "FREE_ONLY",
    "paid_dependency_required": false,
    "external_cdn_required": false
  }
}