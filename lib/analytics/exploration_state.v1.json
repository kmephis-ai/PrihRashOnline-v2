{
  "schema": "PRH_EXPLORATION_STATE_V1",
  "version": "1.0.0",
  "session_schema": "PRH_EXPLORATION_SESSION_V1",
  "roadmap_id": "ANL-074",
  "upstream": {
    "visualization_foundation": "PRH_VISUALIZATION_FOUNDATION_V1@1.0.0",
    "filter_context": "PRH_FILTER_CONTEXT_V1@1.0.0",
    "drill_context": "PRH_DRILL_CONTEXT_V1@1.0.0",
    "semantic_registry": "PRH_ANALYTICS_SEMANTIC_REGISTRY_V1@1.0.0",
    "analytics_scope": "PRH_ANALYTICS_SCOPE_V1@1.0.0",
    "financial_truth_policy": "FIN-TRUTH-v1"
  },
  "state": {
    "default_scope_id": "DEFAULT_ANALYSIS",
    "widget_scope_modes": ["INHERIT_GLOBAL", "OVERRIDE"],
    "widget_id_pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
    "widget_contexts_sorted_by_id": true,
    "state_identity": "SHA256_CANONICAL_JSON_V1",
    "configuration_only": true,
    "history_serialized": false
  },
  "filter_composition": {
    "reuse_viz_filter_context": true,
    "same_field_include": "SET_INTERSECTION",
    "same_field_exclude": "SET_UNION",
    "exclude_applied_after_include": true,
    "empty_effective_include": "DENY_CONTRADICTION",
    "output_revalidated_by_viz": true
  },
  "scope_composition": {
    "reuse_scope_spec": true,
    "global_scope_required": true,
    "widget_inherit": "USE_GLOBAL_EXACTLY",
    "widget_override": "USE_WIDGET_EXACTLY",
    "implicit_scope_merge": false,
    "assignment_overlay_in_state": false
  },
  "drill": {
    "reuse_viz_drill_context": true,
    "effective_drill_filters": "GLOBAL_PLUS_SOURCE_WIDGET_PLUS_DRILL_FILTERS",
    "financial_payload": false
  },
  "actions": [
    "SET_GLOBAL_CONTEXT",
    "SET_WIDGET_CONTEXT",
    "REMOVE_WIDGET_CONTEXT",
    "SET_DRILL_CONTEXT",
    "CLEAR_DRILL_CONTEXT",
    "RESET",
    "BACK"
  ],
  "history": {
    "max_depth": 32,
    "no_op_pushes_history": false,
    "reset_pushes_previous_when_changed": true,
    "back_restores_exact_prior_state": true
  },
  "url_state": {
    "prefix": "prh1.",
    "encoding": "BASE64URL_CANONICAL_JSON_UTF8",
    "private_app_only": true,
    "public_shareable": false,
    "max_json_bytes": 8192,
    "max_encoded_chars": 12000,
    "canonical_reencode_required": true,
    "history_included": false,
    "analytics_results_included": false,
    "scope_assignments_included": false
  },
  "forbidden_payload_keys": [
    "data", "dataset", "rows", "points", "transactions", "records", "result", "results", "measures",
    "amount", "amount_minor", "income_minor", "expense_minor", "cash_flow_minor", "savings_minor",
    "budget_variance_minor", "gross_expense_minor", "refund_minor", "transfer_minor", "scope_assignments"
  ],
  "telemetry_allowlist": [
    "schema", "version", "action", "decision", "reason", "state_hash",
    "history_depth", "widget_count", "global_scope_id", "drill_active"
  ],
  "authorities": {
    "financial_truth": false,
    "financial_write": false,
    "canonical_mutation": false,
    "query_execution": false,
    "io": false,
    "network": false,
    "storage": false,
    "renderer": false
  },
  "free_only": true
}
