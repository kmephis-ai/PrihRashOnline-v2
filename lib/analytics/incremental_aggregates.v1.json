{
  "schema": "PRH_INCREMENTAL_ANALYTICS_AGGREGATES_V1",
  "version": "1.0.0",
  "roadmap_id": "PERF-013",
  "canonical_schema": "PRH_CANONICAL_TRANSACTION_V1@1",
  "repository_contract": "PRH_TRANSACTION_REPOSITORY_V1@1.0.0",
  "analytics_contract": "PRH_ANALYTICS_CONTRACT_V1@1.0.0",
  "financial_truth_policy": "FIN-TRUTH-v1",
  "currency_mode": "SINGLE_CURRENCY",
  "projections": ["MONTH", "CATEGORY_ID", "ACCOUNT_ID"],
  "measures": ["INCOME", "EXPENSE", "CASH_FLOW", "SAVINGS", "GROSS_EXPENSE", "REFUND", "TRANSFER"],
  "state": {
    "schema": "PRH_INCREMENTAL_ANALYTICS_AGGREGATES_STATE_V1",
    "exact_base_revision_required": true,
    "state_hash_required": true,
    "membership_index_required": true,
    "financial_payload_public_evidence_allowed": false
  },
  "delta": {
    "identity": "transaction_id",
    "change_fingerprint": "SHA256_STABLE_CANONICAL_TRANSACTION",
    "classes": ["ADDED", "REMOVED", "CHANGED"],
    "recompute_scope": "AFFECTED_PROJECTION_BUCKETS_ONLY",
    "identical_revision": "NOOP",
    "unknown_or_tampered_state": "FAIL_CLOSED"
  },
  "semantics": {
    "measure_authority": "PRH_KPI_DICTIONARY_V1.evaluateKpis",
    "analytics_parity_authority": "PRH_ANALYTICS_CONTRACT_V1.evaluateAnalytics",
    "month_basis": "occurred_at_UTC_YYYY_MM",
    "category_basis": "category_id",
    "account_basis": "account_id",
    "ui_coupling": false,
    "renderer_coupling": false
  },
  "evidence": {
    "financial_payload_allowed": false,
    "transaction_identity_allowed": false,
    "fields": ["operation", "status", "base_revision_hash_prefix", "result_revision_hash_prefix", "added_count", "removed_count", "changed_count", "affected_bucket_count", "recomputed_bucket_count", "projection_count"]
  },
  "authority": {
    "financial_semantics": false,
    "financial_write": false,
    "migration": false,
    "network": false,
    "ui": false,
    "external_provider_required": false,
    "paid_dependency_required": false
  }
}
