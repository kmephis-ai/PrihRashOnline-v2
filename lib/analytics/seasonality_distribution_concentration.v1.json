{
  "schema": "PRH_SEASONALITY_DISTRIBUTION_CONCENTRATION_V1",
  "version": "1.0.0",
  "roadmap_id": "ANL-091",
  "schemas": {
    "request": "PRH_ANALYTICS_SHAPE_REQUEST_V1",
    "dataset": "PRH_ANALYTICS_DAILY_DRIVER_DATASET_V1",
    "result": "PRH_ANALYTICS_SHAPE_RESULT_V1",
    "drill": "PRH_ANALYTICS_SHAPE_DRILL_V1"
  },
  "upstream": {
    "analytics_contract": "PRH_ANALYTICS_CONTRACT_V1@1.0.0",
    "semantic_registry": "PRH_ANALYTICS_SEMANTIC_REGISTRY_V1@1.0.0",
    "financial_truth_policy": "FIN-TRUTH-v1"
  },
  "supported_core_measures": ["INCOME", "EXPENSE", "CASH_FLOW"],
  "supported_dimensions": ["category_id", "account_id", "member_id", "project_id"],
  "seasonality": {
    "calendar_buckets": ["DAY_OF_MONTH", "WEEKDAY", "MONTH_OF_YEAR"],
    "weekday_numbering": "ISO_MONDAY_1_SUNDAY_7",
    "date_semantics": "LOCAL_CALENDAR_DAY_PREAGGREGATED_IN_REQUEST_TIMEZONE",
    "missing_day_policy": "UNOBSERVED_NOT_ZERO",
    "explicit_zero_policy": "OBSERVED_DAY_WITH_NO_ROWS_EQUALS_ZERO"
  },
  "distribution": {
    "percentiles": [10, 25, 50, 75, 90, 95],
    "algorithm": "NEAREST_RANK_V1",
    "bases": ["DAILY_TOTALS", "DRIVER_TOTALS"]
  },
  "concentration": {
    "abc_thresholds_bps": {"a": 8000, "b": 9500},
    "pareto_threshold_bps": 8000,
    "metrics": ["TOP1_BPS", "TOP3_BPS", "TOP5_BPS", "HHI_10000", "PARETO80_DRIVER_COUNT"],
    "incompatible_policy": "NOT_APPLICABLE_FOR_NEGATIVE_VALUES_OR_NONPOSITIVE_TOTAL"
  },
  "limits": {
    "max_period_days": 3660,
    "max_observed_days": 3660,
    "max_rows": 100000,
    "max_drivers": 5000,
    "max_driver_id_length": 128
  },
  "principles": {
    "query_execution_allowed": false,
    "query_mutation_allowed": false,
    "financial_formula_authority": false,
    "financial_write_allowed": false,
    "storage_allowed": false,
    "network_allowed": false,
    "renderer_authority": false,
    "public_financial_values_allowed": false,
    "free_only": true
  },
  "telemetry_allowlist": [
    "schema",
    "version",
    "measure",
    "dimension",
    "query_hash_prefix",
    "dataset_hash_prefix",
    "result_hash_prefix",
    "coverage_status",
    "period_days",
    "observed_day_count",
    "missing_day_count",
    "driver_count",
    "concentration_status",
    "decision",
    "reason"
  ],
  "authorities": {
    "financial_truth": false,
    "financial_write": false,
    "query_execution": false,
    "query_mutation": false,
    "canonical_mutation": false,
    "storage": false,
    "network": false,
    "authorization": false,
    "deployment": false,
    "renderer": false
  }
}
