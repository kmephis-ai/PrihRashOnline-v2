{
  "schema": "PRH_ANALYTICS_CONTRACT_V1",
  "version": "1.0.0",
  "query_schema": "PRH_ANALYTICS_QUERY_V1",
  "result_schema": "PRH_ANALYTICS_RESULT_V1",
  "canonical_transaction_schema": "PRH_CANONICAL_TRANSACTION_V1",
  "kpi_dictionary_schema": "PRH_KPI_DICTIONARY_V1",
  "financial_truth_policy": "FIN-TRUTH-v1",
  "money_representation": "integer_minor_units",
  "currency_mode": "SINGLE_CURRENCY",
  "renderer_neutral": true,
  "storage_neutral": true,
  "ui_logic_authoritative": false,
  "measures": [
    "INCOME",
    "EXPENSE",
    "CASH_FLOW",
    "SAVINGS",
    "BUDGET_VARIANCE",
    "GROSS_EXPENSE",
    "REFUND",
    "TRANSFER"
  ],
  "dimensions": [
    "account_id",
    "category_id",
    "member_id",
    "project_id",
    "type"
  ],
  "filters": {
    "fields": [
      "account_id",
      "category_id",
      "member_id",
      "project_id",
      "type",
      "status",
      "tag"
    ],
    "operators": ["EQ", "IN"]
  },
  "time": {
    "range": "[start,end)",
    "grains": ["NONE", "DAY", "MONTH", "YEAR"],
    "partial_period_policy": "EXPLICIT_WINDOW_NO_IMPLICIT_PRORATION"
  },
  "comparison_modes": ["NONE", "PREVIOUS_PERIOD"],
  "sort": {
    "keys": ["DIMENSION", "MEASURE"],
    "directions": ["ASC", "DESC"]
  },
  "limits": {
    "max_measures": 8,
    "max_dimensions": 3,
    "max_filters": 16,
    "max_filter_values": 64,
    "max_rows": 5000
  },
  "query_identity": "SHA256_CANONICAL_JSON_V1",
  "provenance_required": [
    "contract_version",
    "query_hash",
    "canonical_schema",
    "kpi_dictionary_version",
    "financial_truth_policy",
    "input_revision"
  ],
  "authorities": {
    "io": false,
    "network": false,
    "financial_write": false,
    "ui": false
  }
}
