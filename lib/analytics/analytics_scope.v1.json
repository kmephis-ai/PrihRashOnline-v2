{
  "schema": "PRH_ANALYTICS_SCOPE_V1",
  "version": "1.0.0",
  "assignments_schema": "PRH_ANALYTICS_SCOPE_ASSIGNMENTS_V1",
  "roadmap_id": "SCOPE-070",
  "upstream": {
    "analytics_contract": "PRH_ANALYTICS_CONTRACT_V1@1.0.0",
    "semantic_registry": "PRH_ANALYTICS_SEMANTIC_REGISTRY_V1@1.0.0",
    "canonical_transaction": "PRH_CANONICAL_TRANSACTION_V1",
    "financial_truth_policy": "FIN-TRUTH-v1"
  },
  "principles": {
    "canonical_truth_mutated": false,
    "canonical_user_tags_authoritative_for_system_scope": false,
    "system_assignments_separate_overlay": true,
    "assignment_overlay_private_by_default": true,
    "scope_spec_contains_private_ids": false,
    "deny_wins": true,
    "renderer_neutral": true,
    "storage_neutral": true,
    "free_only": true
  },
  "system_tags": {
    "EXCLUDE_FROM_ANALYSIS": {
      "protected": true,
      "assignment_levels": ["ACCOUNT", "TRANSACTION"],
      "policy_role": "EXCLUSION",
      "canonical_user_tag_collision_authoritative": false
    },
    "EMERGENCY_FUND": {
      "protected": true,
      "assignment_levels": ["ACCOUNT", "TRANSACTION"],
      "policy_role": "INCLUSION_MARKER",
      "canonical_user_tag_collision_authoritative": false
    }
  },
  "assignment_semantics": {
    "account_match": "SOURCE_OR_DESTINATION_ACCOUNT_TOUCHES_TRANSACTION",
    "transaction_match": "EXACT_TRANSACTION_ID",
    "combined_tags": "SET_UNION",
    "unknown_target": "DENY_ASSIGNMENT_OVERLAY",
    "unknown_system_tag": "DENY_ASSIGNMENT_OVERLAY",
    "duplicate_target_assignment": "DENY_ASSIGNMENT_OVERLAY",
    "duplicate_system_tag": "DENY_ASSIGNMENT_OVERLAY"
  },
  "built_in_scopes": {
    "ALL_CANONICAL": {
      "include_any_system_tags": [],
      "exclude_any_system_tags": []
    },
    "DEFAULT_ANALYSIS": {
      "include_any_system_tags": [],
      "exclude_any_system_tags": ["EXCLUDE_FROM_ANALYSIS"]
    },
    "EMERGENCY_FUND_ONLY": {
      "include_any_system_tags": ["EMERGENCY_FUND"],
      "exclude_any_system_tags": ["EXCLUDE_FROM_ANALYSIS"]
    }
  },
  "scope_spec": {
    "schema": "PRH_ANALYTICS_SCOPE_SPEC_V1",
    "required_keys": ["schema", "contract_version", "scope_id", "include_any_system_tags", "exclude_any_system_tags"],
    "scope_id_pattern": "^[A-Z][A-Z0-9_]{2,63}$",
    "unknown_system_tag": "DENY",
    "duplicate_system_tag": "DENY",
    "include_exclude_overlap": "DENY",
    "extra_key": "DENY",
    "private_target_ids": "NOT_ALLOWED"
  },
  "serialization": {
    "format": "CANONICAL_JSON_KEYS_SORTED_ARRAYS_SORTED",
    "deterministic": true,
    "financial_payload": false,
    "account_ids": false,
    "transaction_ids": false,
    "assignment_overlay": false
  },
  "telemetry_allowlist": [
    "schema", "version", "scope_id", "decision", "reason",
    "include_system_tags", "exclude_system_tags", "included_count", "excluded_count"
  ],
  "authorities": {
    "financial_truth": false,
    "financial_write": false,
    "canonical_mutation": false,
    "io": false,
    "network": false,
    "storage": false,
    "renderer": false,
    "ui": false
  }
}
