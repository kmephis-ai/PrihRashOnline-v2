{
  "schema": "PRH_PERSONAL_BENCHMARK_V1",
  "version": "1.0.0",
  "roadmap_id": "BENCH-070",
  "spec_schema": "PRH_PERSONAL_BENCHMARK_SPEC_V1",
  "source_schema": "PRH_PERSONAL_BENCHMARK_SOURCE_V1",
  "result_schema": "PRH_PERSONAL_BENCHMARK_RESULT_V1",
  "money_reference_schema": "PRH_PERSONAL_BENCHMARK_MONEY_REFERENCE_V1",
  "manual_index_schema": "PRH_PERSONAL_BENCHMARK_MANUAL_INDEX_V1",
  "upstream": {
    "analytics_contract": "PRH_ANALYTICS_CONTRACT_V1@1.0.0",
    "semantic_registry": "PRH_ANALYTICS_SEMANTIC_REGISTRY_V1@1.0.0",
    "period_engine": "PRH_ANALYTICS_PERIOD_ENGINE_V1@1.0.0",
    "calculated_metrics": "PRH_ANALYTICS_CALCULATED_METRICS_V1@1.0.0",
    "analytics_scope": "PRH_ANALYTICS_SCOPE_V1@1.0.0",
    "financial_truth_policy": "FIN-TRUTH-v1"
  },
  "principles": {
    "allowlisted_comparisons_only": true,
    "period_semantics_redefined": false,
    "calculated_delta_formula_duplicated": false,
    "scope_semantics_redefined": false,
    "declared_reference_is_financial_truth": false,
    "renderer_neutral": true,
    "storage_neutral": true,
    "core_network_required": false,
    "external_market_provider_required": false,
    "paid_provider_required": false,
    "financial_values_embedded_in_spec": false,
    "financial_values_allowed_in_public_telemetry": false,
    "free_only": true
  },
  "comparison_types": {
    "PREVIOUS_COMPARABLE_PERIOD": {
      "source": "ANL_071_PERIOD_COMPARISON",
      "reference": "PERIOD_RESULT_COMPARISON",
      "derived_delta": "ANL_072_DELTA_ABS_AND_DELTA_PCT",
      "declared_reference": false
    },
    "PERSONAL_ROLLING_BASELINE": {
      "source": "ANL_071_PRIMARY_PERIOD_SERIES",
      "reference": "ANL_072_MOVING_AVERAGE_PRIOR_BUCKETS",
      "declared_reference": false,
      "options": {"window": {"min": 2, "max": 24}, "partial_window": ["REQUIRE_FULL", "ALLOW_PARTIAL"]}
    },
    "BUDGET": {
      "source": "PERIOD_TOTAL",
      "reference": "DECLARED_MONEY_REFERENCE",
      "reference_provenance": "DECLARED_BUDGET",
      "declared_reference": true
    },
    "TARGET": {
      "source": "PERIOD_TOTAL",
      "reference": "DECLARED_MONEY_REFERENCE",
      "reference_provenance": "DECLARED_TARGET",
      "declared_reference": true
    },
    "MANUAL_INDEX": {
      "source": "PERIOD_TOTAL",
      "reference": "DECLARED_BASE_X_INDEX_PPM",
      "reference_provenance": "USER_DEFINED_MANUAL_INDEX",
      "declared_reference": true
    }
  },
  "limits": {
    "max_source_buckets": 500,
    "max_rolling_window": 24,
    "max_manual_index_ppm": 10000000,
    "max_manual_base_abs_minor": 500000000
  },
  "telemetry_allowlist": [
    "schema", "version", "comparison_type", "measure_id", "scope_id", "selector_kind", "grain",
    "primary_day_count", "sample_count", "sample_complete", "quality", "decision", "reason",
    "period_engine_version", "calculated_metrics_version", "scope_contract_version", "financial_truth_policy"
  ],
  "authorities": {
    "financial_truth": false,
    "financial_write": false,
    "io": false,
    "network": false,
    "storage": false,
    "renderer": false,
    "ui": false,
    "external_market_data": false
  }
}
