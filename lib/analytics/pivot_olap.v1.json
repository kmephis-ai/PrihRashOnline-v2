{
  "schema": "PRH_PIVOT_OLAP_V1",
  "version": "1.0.0",
  "roadmap_id": "ANL-073",
  "spec_schema": "PRH_PIVOT_SPEC_V1",
  "result_schema": "PRH_PIVOT_RESULT_V1",
  "drill_schema": "PRH_PIVOT_DRILL_DESCRIPTOR_V1",
  "requery_schema": "PRH_PIVOT_HIERARCHY_REQUERY_V1",
  "upstream": {
    "analytics_contract": "PRH_ANALYTICS_CONTRACT_V1@1.0.0",
    "semantic_registry": "PRH_ANALYTICS_SEMANTIC_REGISTRY_V1@1.0.0",
    "calculated_metrics": "PRH_ANALYTICS_CALCULATED_METRICS_V1@1.0.0",
    "visualization_foundation": "PRH_VISUALIZATION_FOUNDATION_V1@1.0.0",
    "financial_truth_policy": "FIN-TRUTH-v1"
  },
  "principles": {
    "analytics_result_is_input_authority": true,
    "canonical_kpi_recalculated": false,
    "additive_sum_only_v1": true,
    "non_additive_guessing": false,
    "hierarchy_transition_from_registry_only": true,
    "hierarchy_detail_requires_requery": true,
    "top_n_reuses_calculated_metrics": true,
    "renderer_neutral": true,
    "storage_neutral": true,
    "financial_payload_in_spec": false,
    "public_financial_evidence": "SYNTHETIC_ONLY",
    "free_only": true
  },
  "axis": {
    "max_row_dimensions": 2,
    "max_column_dimensions": 2,
    "max_total_dimensions": 3,
    "time_hierarchy_id": "TIME",
    "time_levels": ["YEAR", "MONTH", "DAY"],
    "other_key": "__OTHER__"
  },
  "sort": {
    "axes": ["ROWS", "COLUMNS"],
    "by": ["KEY", "MEASURE"],
    "directions": ["ASC", "DESC"],
    "tie_break": "CANONICAL_AXIS_KEY_ASC"
  },
  "top_n": {
    "axes": ["ROWS", "COLUMNS"],
    "min": 1,
    "max": 50,
    "operator": "TOP_N_OTHER",
    "other_required_when_remainder": true
  },
  "hierarchy": {
    "actions": ["EXPAND", "COLLAPSE"],
    "query_change": "REEXECUTE_CANONICAL_ANALYTICS_QUERY",
    "implicit_detail_synthesis": false
  },
  "limits": {
    "max_source_rows": 5000,
    "max_cells": 5000,
    "max_measures": 8,
    "max_subtotals": 5000
  },
  "telemetry_allowlist": [
    "schema", "version", "spec_hash", "source_query_hash", "row_axis_count", "column_axis_count",
    "measure_count", "row_member_count", "column_member_count", "cell_count", "subtotal_count",
    "top_n_axis", "hierarchy_active", "decision", "reason", "semantic_registry_version",
    "calculated_metrics_version", "financial_truth_policy"
  ],
  "authorities": {
    "financial_truth": false,
    "financial_write": false,
    "io": false,
    "network": false,
    "storage": false,
    "renderer": false,
    "ui": false,
    "query_execution": false
  }
}
