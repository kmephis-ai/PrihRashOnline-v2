{
  "schema": "PRH_ANALYTICS_CALCULATED_METRICS_V1",
  "version": "1.0.0",
  "roadmap_id": "ANL-072",
  "spec_schema": "PRH_ANALYTICS_CALCULATED_SPEC_V1",
  "result_schema": "PRH_ANALYTICS_CALCULATED_RESULT_V1",
  "upstream": {
    "analytics_contract": "PRH_ANALYTICS_CONTRACT_V1@1.0.0",
    "semantic_registry": "PRH_ANALYTICS_SEMANTIC_REGISTRY_V1@1.0.0",
    "period_engine": "PRH_ANALYTICS_PERIOD_ENGINE_V1@1.0.0",
    "financial_truth_policy": "FIN-TRUTH-v1"
  },
  "semantics": {
    "allowlisted_operators_only": true,
    "arbitrary_executable_formula_allowed": false,
    "eval_allowed": false,
    "sql_expression_allowed": false,
    "kpi_formula_redefinition": false,
    "renderer_neutral": true,
    "storage_neutral": true,
    "financial_values_embedded_in_spec": false,
    "missing_group_value": "ZERO_FOR_ADDITIVE_MEASURE",
    "ratio_scale": 1000000,
    "ratio_unit": "PPM",
    "money_rounding": "HALF_AWAY_FROM_ZERO_MINOR_UNIT",
    "free_only": true
  },
  "operators": {
    "SHARE": {
      "source": "ANALYTICS_RESULT",
      "requires_additive_measure": true,
      "allowed_measures": ["INCOME", "EXPENSE", "GROSS_EXPENSE", "REFUND", "TRANSFER"],
      "options": {"denominator_scope": ["RESULT_TOTAL"]},
      "output": "RATIO_PPM",
      "zero_denominator": "FAIL_CLOSED"
    },
    "DELTA_ABS": {
      "source": "PERIOD_RESULT_COMPARISON",
      "requires_additive_measure": true,
      "options": {"reference": ["PERIOD_COMPARISON"]},
      "output": "MONEY_MINOR"
    },
    "DELTA_PCT": {
      "source": "PERIOD_RESULT_COMPARISON",
      "requires_additive_measure": true,
      "options": {"reference": ["PERIOD_COMPARISON"]},
      "output": "RATIO_PPM",
      "zero_reference": "EXPLICIT_UNDEFINED_UNLESS_BOTH_ZERO"
    },
    "CUMULATIVE": {
      "source": "PERIOD_RESULT_PRIMARY",
      "requires_additive_measure": true,
      "options": {},
      "output": "MONEY_MINOR"
    },
    "MOVING_AVERAGE": {
      "source": "PERIOD_RESULT_PRIMARY",
      "requires_additive_measure": true,
      "options": {"window": {"min": 1, "max": 24}, "partial_window": ["REQUIRE_FULL", "ALLOW_PARTIAL"]},
      "output": "MONEY_MINOR"
    },
    "MOVING_MEDIAN": {
      "source": "PERIOD_RESULT_PRIMARY",
      "requires_additive_measure": true,
      "options": {"window": {"min": 1, "max": 24}, "partial_window": ["REQUIRE_FULL", "ALLOW_PARTIAL"]},
      "output": "MONEY_MINOR"
    },
    "TOP_N_OTHER": {
      "source": "ANALYTICS_RESULT",
      "requires_additive_measure": true,
      "options": {"n": {"min": 1, "max": 50}},
      "output": "MONEY_MINOR",
      "other_key": "__OTHER__",
      "tie_break": "CANONICAL_DIMENSION_KEY_ASC"
    }
  },
  "limits": {
    "max_window": 24,
    "max_top_n": 50,
    "max_source_rows": 500,
    "max_source_buckets": 500
  },
  "telemetry_allowlist": [
    "schema", "version", "operator", "measure_id", "source_kind", "window", "top_n",
    "input_count", "output_count", "decision", "reason", "financial_truth_policy",
    "semantic_registry_version", "period_engine_version"
  ],
  "authorities": {
    "financial_truth": false,
    "financial_write": false,
    "io": false,
    "network": false,
    "storage": false,
    "renderer": false,
    "ui": false,
    "executable_formula": false
  }
}
