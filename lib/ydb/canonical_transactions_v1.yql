CREATE TABLE canonical_transactions_v1 (
  transaction_id Utf8 NOT NULL,
  schema Utf8 NOT NULL,
  schema_version Uint32 NOT NULL,
  occurred_at Utf8 NOT NULL,
  type Utf8 NOT NULL,
  status Utf8 NOT NULL,
  amount_minor Uint64 NOT NULL,
  currency Utf8 NOT NULL,
  account_id Utf8 NOT NULL,
  destination_account_id Utf8,
  category_id Utf8 NOT NULL,
  member_id Utf8,
  project_id Utf8,
  tags_json Utf8 NOT NULL,
  counterparty Utf8,
  description Utf8,
  reverses_transaction_id Utf8,
  adjustment_semantics Utf8,
  provenance_source_system Utf8 NOT NULL,
  provenance_source_container Utf8,
  provenance_source_record_id Utf8 NOT NULL,
  provenance_source_fingerprint Utf8 NOT NULL,
  provenance_identity_strategy Utf8 NOT NULL,
  provenance_transform_version Utf8 NOT NULL,
  provenance_source_position Utf8,
  PRIMARY KEY (transaction_id)
);
