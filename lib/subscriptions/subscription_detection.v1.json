{
  "schema": "PRH_SUBSCRIPTION_DETECTION_V1",
  "version": "1.0.0",
  "roadmap_id": "SUB-030",
  "upstream": {
    "canonical_transaction": "PRH_CANONICAL_TRANSACTION_V1",
    "obligations": "PRH_OBLIGATIONS_V1@1.0.0"
  },
  "eligibility": {
    "type": "expense",
    "status": "posted",
    "label_source_priority": ["counterparty", "description"],
    "missing_label": "EXCLUDE"
  },
  "signature": {
    "schema": "PRH_SUBSCRIPTION_SIGNATURE_V1",
    "normalization": "NFKC_TRIM_COLLAPSE_WHITESPACE_LOWERCASE",
    "group_fields": ["normalized_label", "currency", "account_id", "category_id"],
    "identity": "SHA256(PRH_SUBSCRIPTION_SIGNATURE_V1|CANONICAL_JSON_GROUP_FIELDS)",
    "fuzzy_matching": false
  },
  "history": {
    "max_input_transactions": 50000,
    "max_group_occurrences": 24,
    "minimum_candidate_occurrences": 3,
    "max_span_days": 730,
    "older_group_history": "DROP_DETERMINISTICALLY_KEEP_LATEST"
  },
  "cadence": {
    "supported": ["WEEKLY", "MONTHLY"],
    "weekly": {"expected_days": 7, "tolerance_days": 1},
    "monthly": {"required_month_step": 1, "day_of_month_tolerance": 3, "nominal_day": "MAX_OBSERVED_DAY_CLAMP_TO_MONTH_END"},
    "all_intervals_must_match": true
  },
  "amount_stability": {
    "reference": "LOWER_MEDIAN_MINOR",
    "absolute_tolerance_minor": 100,
    "relative_tolerance_basis_points": 500,
    "effective_tolerance": "MAX_ABSOLUTE_OR_FLOOR_RELATIVE",
    "all_occurrences_must_match": true,
    "financial_truth": false
  },
  "review": {
    "statuses": ["CANDIDATE", "REVIEW", "NO_CANDIDATE", "ALREADY_TRACKED"],
    "auto_confirm": false,
    "auto_create_obligation": false,
    "canonical_mutation": false,
    "financial_write": false,
    "candidate_is_financial_truth": false
  },
  "obligation_comparison": {
    "mode": "EXPLICIT_SIGNATURE_HASH_TO_PLAN_ID_LINK_ONLY",
    "fuzzy_plan_label_matching": false,
    "required_plan_direction": "OUTFLOW",
    "currency_must_match": true,
    "cadence_must_match": true,
    "reference_amount_must_equal_plan_amount": true,
    "mutation": false
  },
  "privacy": {
    "public_evidence": "INDEPENDENTLY_GENERATED_SYNTHETIC_ONLY",
    "telemetry_allowlist": ["schema", "version", "query_hash", "status", "reason_code", "group_count", "candidate_count", "review_count", "already_tracked_count", "rejected_group_count", "cadence_count"],
    "raw_label_allowed_in_public_telemetry": false,
    "transaction_id_allowed_in_public_telemetry": false,
    "dimension_id_allowed_in_public_telemetry": false,
    "financial_value_allowed_in_public_telemetry": false
  },
  "authority": {
    "financial_truth": false,
    "canonical_transaction": false,
    "obligation_plan": false,
    "storage": false,
    "network": false,
    "financial_write": false,
    "deployment": false
  },
  "cost": {"class": "FREE_ONLY", "paid_dependency_required": false, "external_provider_required": false}
}
