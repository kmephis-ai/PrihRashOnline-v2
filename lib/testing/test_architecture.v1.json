        "^roadmap_task_protocol_contract_test\\.js$",
        "^multi_ai_review_protocol_contract_test\\.js$",
        "^analytics_documentation_contract_test\\.js$",
        "^test_architecture_contract_test\\.js$",
        "^.*(documentation|docs|policy|security|privacy|free_only|finops|audit|telemetry|supply|trust|governance|language|ai_).*_test\\.js$"
      ],
      "budget": { "max_files": 48, "max_seconds": 60 }
