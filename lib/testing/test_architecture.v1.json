      "budget": { "max_files": 48, "max_seconds": 90 }
    },
    {
      "id": "ADAPTER_INTEGRATION",
      "authority": "ports-adapters-integration",
      "patterns": [
        "^repository_adapter_contract_test\\.js$",
        "^.*adapter.*_test\\.js$",
        "^.*mapper.*_test\\.js$"
      ],
      "budget": { "max_files": 32, "max_seconds": 60 }
    },
    {
      "id": "RUNTIME_INTEGRATION",
      "authority": "runtime-deploy-recovery-integration",
      "patterns": [
        "^.*(runtime|deployment|deploy|release|backup|restore|apps_script|gateway).*_test\\.js$"
      ],
      "budget": { "max_files": 40, "max_seconds": 90 }
    },
    {
      "id": "UI_E2E",
      "authority": "ui-rendering-e2e",
      "patterns": [
        "^dashboard_.*_test\\.js$",
        "^.*(visual|responsive|playwright|web_ui|ui_).*_test\\.js$"
      ],
      "budget": { "max_files": 48, "max_seconds": 210 }
    },
    {
      "id": "POLICY_GOVERNANCE",
      "authority": "policy-docs-ci-ai-governance",
