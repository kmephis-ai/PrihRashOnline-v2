{
  "schema": "PRH_KPI_DICTIONARY_V1",
  "version": "1.0.0",
  "financial_truth_policy": "FIN-TRUTH-v1",
  "scope": {
    "included_status": "posted",
    "money_representation": "integer_minor_units",
    "rounding_policy": "NO_IMPLICIT_ROUNDING",
    "currency_mode": "SINGLE_CURRENCY",
    "mixed_currency_policy": "FAIL_CLOSED_UNTIL_FX_LAYER",
    "period_basis": "occurred_at",
    "period_bounds": "START_INCLUSIVE_END_EXCLUSIVE",
    "partial_period_policy": "EXPLICIT_WINDOW_NO_IMPLICIT_PRORATION",
    "comparison_policy": "EXPLICIT_COMPARABLE_WINDOWS_ONLY"
  },
  "transaction_semantics": {
    "income": "INCREASES_INCOME_AND_CASH_FLOW",
    "expense": "INCREASES_GROSS_EXPENSE_AND_REDUCES_CASH_FLOW",
    "refund": "REDUCES_EXTERNAL_EXPENSE_AND_INCREASES_CASH_FLOW_NOT_INCOME",
    "transfer": "MEASURED_SEPARATELY_NEUTRAL_TO_INCOME_EXPENSE_CASH_FLOW_SAVINGS",
    "adjustment": "ZERO_ONLY_IN_FIN_TRUTH_V1"
  },
  "kpis": {
    "INCOME": {
      "output": "income_minor",
      "unit": "minor_currency_unit",
      "formula": "SUM_POSTED_INCOME",
      "dependencies": []
    },
    "EXPENSE": {
      "output": "expense_minor",
      "unit": "minor_currency_unit",
      "formula": "GROSS_EXPENSE_MINUS_REFUNDS",
      "dependencies": ["GROSS_EXPENSE", "REFUND"]
    },
    "CASH_FLOW": {
      "output": "cash_flow_minor",
      "unit": "minor_currency_unit",
      "formula": "INCOME_MINUS_EXPENSE",
      "dependencies": ["INCOME", "EXPENSE"]
    },
    "SAVINGS": {
      "output": "savings_minor",
      "unit": "minor_currency_unit",
      "formula": "INCOME_MINUS_EXPENSE",
      "dependencies": ["INCOME", "EXPENSE"],
      "semantic_scope": "REALIZED_TRANSACTION_PERIOD"
    },
    "BUDGET_VARIANCE": {
      "output": "budget_variance_minor",
      "unit": "minor_currency_unit",
      "formula": "BUDGET_MINUS_EXPENSE",
      "dependencies": ["EXPENSE", "BUDGET"],
      "positive_meaning": "FAVORABLE_UNDER_BUDGET",
      "budget_scope": "SAME_EXPLICIT_PERIOD_AND_CURRENCY"
    },
    "GROSS_EXPENSE": {
      "output": "gross_expense_minor",
      "unit": "minor_currency_unit",
      "formula": "SUM_POSTED_EXPENSE",
      "dependencies": []
    },
    "REFUND": {
      "output": "refund_minor",
      "unit": "minor_currency_unit",
      "formula": "SUM_POSTED_REFUND_EXPENSE_REDUCTION",
      "dependencies": []
    },
    "TRANSFER": {
      "output": "transfer_minor",
      "unit": "minor_currency_unit",
      "formula": "SUM_POSTED_TRANSFER_MEASURE_ONLY",
      "dependencies": []
    }
  },
  "provenance": {
    "canonical_source": "lib/finance/financial_reconciliation.js",
    "legacy_total_cells_authoritative": false,
    "ui_or_chart_logic_authoritative": false
  }
}
