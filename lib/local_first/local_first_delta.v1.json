{
  "schema": "PRH_LOCAL_FIRST_DELTA_V1",
  "version": "1.0.0",
  "roadmap_id": "DELTA-LF-001",
  "phase": "LF2",
  "work_class": "engineering",
  "base_sync_contract": "PRH_LOCAL_FIRST_SYNC_V1@1.0.0",
  "local_store_contract": "PRH_LOCAL_READ_MODEL_V1@1.0.0",
  "canonical_repository_contract": "PRH_TRANSACTION_REPOSITORY_V1@1.0.0",
  "financial_truth_policy": "FIN-TRUTH-v1",
  "transport": {
    "mode": "BACKGROUND_EXPLICIT",
    "warm_path_required": false,
    "google_script_function": "prhLocalFirstDelta",
    "states": ["NOOP", "DELTA", "FULL_REBUILD_REQUIRED"]
  },
  "revision_binding": {
    "algorithm": "CANONICAL_REPOSITORY_REVISION_SHA256",
    "base_required": true,
    "target_generation_id": "EQUALS_TARGET_REVISION",
    "request_inventory_digest": "SHA256_SORTED_RECORD_ETAGS",
    "apply_requires_active_revision_equals_base": true,
    "post_apply_requires_recomputed_revision_equals_target": true
  },
  "inventory": {
    "transaction_key": "transaction_id",
    "transaction_etag": "SHA256_REPOSITORY_REVISION_ROW",
    "dimension_key": "dimension_key",
    "dimension_etag": "SHA256_STABLE_DIMENSION_RECORD",
    "max_transactions": 50000,
    "max_dimensions": 20000,
    "max_delta_operations": 10000,
    "full_rebuild_ratio_threshold": 0.75
  },
  "apply": {
    "mutation_model": "NEW_IMMUTABLE_STAGING_GENERATION",
    "in_place_active_mutation": false,
    "idempotent_target_replay": "ALREADY_APPLIED",
    "base_mismatch": "FULL_REBUILD_REQUIRED",
    "target_revision_mismatch": "ABORT_STAGING_FULL_REBUILD_REQUIRED",
    "count_mismatch": "ABORT_STAGING_FULL_REBUILD_REQUIRED",
    "partial_or_malformed": "PRESERVE_ACTIVE"
  },
  "fallback": {
    "handler": "SYNC_LF_001_FULL_BOOTSTRAP",
    "fake_runtime_data_allowed": false,
    "verified_local_readable_during_failure": true
  },
  "authorities": {
    "canonical_read": true,
    "canonical_financial_write": false,
    "local_derived_write": true,
    "financial_formula": false,
    "network_on_warm_interaction": false,
    "paid_dependency_required": false
  },
  "privacy": {
    "runtime_inventory_and_delta": "OWNER_PRIVATE",
    "public_test_data": "SYNTHETIC_ONLY",
    "public_financial_payload": false,
    "public_evidence_fields": [
      "schema",
      "version",
      "status",
      "reason",
      "base_revision_prefix",
      "target_revision_prefix",
      "upsert_count",
      "delete_count",
      "duration_ms"
    ]
  },
  "invariants": [
    "EXACT_BASE_REVISION_ONLY",
    "IDEMPOTENT_REPLAY",
    "BASE_MISMATCH_FULL_REBUILD",
    "TARGET_REVISION_RECOMPUTED_BEFORE_FINALIZE",
    "PARTIAL_OR_ERROR_CANNOT_REPLACE_ACTIVE",
    "ACTIVE_PLUS_VERIFIED_ONLY_VISIBLE",
    "VERIFIED_LOCAL_READABLE_DURING_NETWORK_FAILURE",
    "REMOTE_SYNC_NOT_REQUIRED_FOR_WARM_SPA",
    "NO_CANONICAL_FINANCIAL_WRITE",
    "FREE_ONLY"
  ]
}
