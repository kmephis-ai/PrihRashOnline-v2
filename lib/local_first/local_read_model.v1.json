{
  "schema": "PRH_LOCAL_READ_MODEL_V1",
  "version": "1.0.0",
  "roadmap_id": "STORE-LF-001",
  "cost_class": "FREE_ONLY",
  "authority": {
    "financial_truth": false,
    "canonical_write": false,
    "remote_sync": false,
    "analytics": false,
    "browser_local_derived_read_only": true
  },
  "database": {
    "engine": "INDEXEDDB",
    "name": "prihrash-local-read-model",
    "version": 1,
    "private_browser_storage": true,
    "schema_upgrade_policy": "FAIL_CLOSED_REBUILD",
    "corruption_policy": "REBUILD_REQUIRED",
    "explicit_wipe_supported": true
  },
  "identity": {
    "canonical_revision_format": "SHA256_HEX_64",
    "generation_id_format": "SHA256_HEX_64",
    "immutable_generation": true,
    "active_pointer_key": "active_generation",
    "manifest_key_prefix": "generation:"
  },
  "stores": {
    "meta": {
      "key_path": "key",
      "generation_scoped": false
    },
    "transactions": {
      "key_path": ["generation_id", "transaction_id"],
      "generation_scoped": true,
      "generation_index": "generation_id"
    },
    "dimensions": {
      "key_path": ["generation_id", "dimension_key"],
      "generation_scoped": true,
      "generation_index": "generation_id"
    },
    "aggregates": {
      "key_path": ["generation_id", "aggregate_key"],
      "generation_scoped": true,
      "generation_index": "generation_id"
    },
    "sync_journal": {
      "key_path": ["generation_id", "sequence"],
      "generation_scoped": true,
      "generation_index": "generation_id"
    }
  },
  "generation_protocol": {
    "states": ["STAGING", "VERIFIED"],
    "visible_state": "ACTIVE_VERIFIED_ONLY",
    "begin": "CREATE_STAGING_MANIFEST",
    "write_chunk": "WRITE_GENERATION_SCOPED_RECORDS_ONLY",
    "finalize": "VERIFY_COUNTS_AND_ATOMICALLY_SWITCH_ACTIVE_POINTER",
    "abort": "DELETE_NON_ACTIVE_STAGING_GENERATION",
    "partial_generation_visible": false,
    "partial_or_failed_finalize_replaces_active": false,
    "active_switch_atomic": true,
    "finalize_requires_exact_revision_match": true
  },
  "read_contract": {
    "active_manifest_required": true,
    "verified_manifest_required": true,
    "revision_pointer_manifest_match_required": true,
    "manifest_count_match_required": true,
    "invalid_active_state": "REBUILD_REQUIRED",
    "unverified_payload_returned": false
  },
  "recovery": {
    "incompatible_schema": "REBUILD_REQUIRED",
    "missing_active_manifest": "REBUILD_REQUIRED",
    "revision_mismatch": "REBUILD_REQUIRED",
    "count_mismatch": "REBUILD_REQUIRED",
    "explicit_rebuild_action": "WIPE_DERIVED_LOCAL_DATABASE_AND_REOPEN_EMPTY",
    "canonical_remote_mutation": false
  },
  "privacy": {
    "financial_payload_in_public_artifacts": false,
    "financial_payload_in_public_telemetry": false,
    "database_export_to_public_artifacts": false,
    "allowed_public_observability": [
      "schema",
      "version",
      "revision_hash_prefix",
      "generation_hash_prefix",
      "state",
      "status",
      "reason",
      "count",
      "duration_ms"
    ]
  },
  "network": {
    "authority": false,
    "mandatory_requests_for_local_read": 0,
    "google_sheets_reads_for_local_read": 0
  }
}
