{
  "schema": "PRH_LOCAL_FINANCE_RUNTIME_V1",
  "version": "1.0.0",
  "roadmap_id": "FIN-LF-001",
  "phase": "LF3",
  "work_class": "user_facing",
  "upstream": {
    "spa": "PRH_LOCAL_FIRST_SPA_V1@1.0.0",
    "store": "PRH_LOCAL_READ_MODEL_V1@1.0.0",
    "worker": "PRH_LOCAL_ANALYTICS_WORKER_V1@1.0.0",
    "sync": "PRH_LOCAL_FIRST_SYNC_V1@1.0.0",
    "delta": "PRH_LOCAL_FIRST_DELTA_V1@1.0.0",
    "analytics": "PRH_ANALYTICS_CONTRACT_V1@1.0.0",
    "financial_truth": "FIN-TRUTH-v1"
  },
  "routes": [
    "home",
    "expenses",
    "income",
    "cash-flow"
  ],
  "filter_context": {
    "schema": "PRH_LOCAL_FINANCE_FILTER_CONTEXT_V1",
    "version": "1.0.0",
    "session_shared": true,
    "fields": [
      "currency",
      "start",
      "end",
      "account_id",
      "category_id",
      "member_id",
      "project_id"
    ],
    "history_financial_payload": false,
    "url_financial_payload": false,
    "route_switch_preserves_context": true
  },
  "queries": {
    "home": [
      "TOTALS",
      "CASH_FLOW_MONTHLY"
    ],
    "expenses": [
      "EXPENSE_TOTAL",
      "EXPENSE_BY_CATEGORY"
    ],
    "income": [
      "INCOME_TOTAL",
      "INCOME_BY_CATEGORY"
    ],
    "cash-flow": [
      "CASH_FLOW_TOTAL",
      "CASH_FLOW_MONTHLY"
    ],
    "executor": "CANONICAL_WEB_WORKER_ONLY",
    "main_thread_financial_formula": false
  },
  "snapshot": {
    "required_state": "ACTIVE_PLUS_VERIFIED",
    "one_generation_per_render_cycle": true,
    "query_binding": [
      "generation_id",
      "revision"
    ],
    "stale_result_commit": false,
    "empty_store": "COLD_FULL_BOOTSTRAP_NO_FAKE_VALUES",
    "sync_failure_with_verified": "DEGRADED_KEEP_LAST_VERIFIED"
  },
  "deployment": {
    "apps_script_html": "LocalFirstSpaWebApp.html",
    "injected_tracked_browser_modules": [
      "pwa/local_read_model_store.js",
      "pwa/local_first_sync.js",
      "pwa/local_first_delta.js",
      "pwa/local_finance_runtime.js",
      "pwa/local_planning_runtime.js"
    ],
    "generated_worker": "tools/build-local-analytics-worker.js",
    "external_runtime_cdn": false,
    "deterministic_exact_candidate": true
  },
  "privacy": {
    "runtime_financial_payload": "OWNER_PRIVATE",
    "public_tests": "SYNTHETIC_ONLY",
    "public_financial_values": false,
    "masked_mode_values_visible": false,
    "zen_mode_values_visible": false,
    "demo_replaces_owner_truth": false
  },
  "authorities": {
    "canonical_financial_write": false,
    "financial_formula": false,
    "google_read_on_warm_route": false,
    "network_on_warm_route": false,
    "network_on_filter_change": false,
    "local_derived_write": true,
    "paid_dependency_required": false
  },
  "product_ready": {
    "owner_uat_required": true,
    "assistant_self_attestation_allowed": false,
    "exact_candidate_required": true,
    "desktop_and_mobile": true
  },
  "invariants": [
    "ONE_ACTIVE_VERIFIED_SNAPSHOT",
    "ONE_SHARED_FILTER_CONTEXT",
    "CANONICAL_WORKER_ONLY_FINANCIAL_RESULTS",
    "EXACT_REVISION_PROVENANCE",
    "STALE_WORKER_RESULT_DISCARDED",
    "ZERO_MANDATORY_NETWORK_WARM_ROUTE",
    "ZERO_MANDATORY_NETWORK_FILTER_CHANGE",
    "DEGRADED_SYNC_PRESERVES_LOCAL_UI",
    "NO_FAKE_OWNER_FINANCIAL_VALUES",
    "NO_CANONICAL_FINANCIAL_WRITE",
    "FREE_ONLY"
  ],
  "planning_extension": {
    "roadmap_id": "PLAN-REC-001",
    "runtime": "PRH_LOCAL_PLANNING_RUNTIME_V1@1.0.0",
    "worker_message": "PLANNING_QUERY",
    "canonical_revision_binding": true,
    "warm_network_required": false,
    "financial_write": false
  }
}
