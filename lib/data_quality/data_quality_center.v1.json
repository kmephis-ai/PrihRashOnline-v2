{
  "schema": "PRH_DATA_QUALITY_CENTER_V1",
  "version": "1.0.0",
  "roadmap_id": "DQ-020",
  "upstream": {
    "canonical_transaction": "PRH_CANONICAL_TRANSACTION_V1",
    "observability": "PRH_SLO_ERROR_BUDGET_V1"
  },
  "schemas": {
    "issue": "PRH_DATA_QUALITY_ISSUE_V1",
    "scan": "PRH_DATA_QUALITY_SCAN_V1",
    "repair_preview": "PRH_DATA_QUALITY_REPAIR_PREVIEW_V1",
    "mutation_gate": "PRH_DATA_QUALITY_MUTATION_GATE_V1"
  },
  "detectors": {
    "canonical_validation": "CANONICAL_SCHEMA_FAIL_CLOSED_V1",
    "exact_duplicate": "SHA256_CANONICAL_BUSINESS_PAYLOAD_V1",
    "suspicious_rules": [
      "ADJUSTMENT_NONZERO",
      "SELF_TRANSFER",
      "REVERSAL_SELF_REFERENCE",
      "SHEET_SOURCE_LOCATION_INCOMPLETE"
    ],
    "provenance_rules": [
      "SOURCE_IDENTITY_DUPLICATE",
      "SHEET_SOURCE_LOCATION_INCOMPLETE"
    ],
    "fuzzy_duplicate_detection": false
  },
  "repair": {
    "automatic_write": false,
    "ambiguous_state": "REVIEW_REQUIRED",
    "default_action": "NO_AUTOFIX",
    "preview_only": true
  },
  "mutation_gate": {
    "required_evidence": ["plan_hash", "backup_binding", "idempotency_key", "rollback_evidence", "readback_evidence"],
    "plan_hash": "SHA256_HEX",
    "backup_schema": "PRH_DQ_BACKUP_BINDING_V1",
    "rollback_schema": "PRH_DQ_ROLLBACK_EVIDENCE_V1",
    "readback_schema": "PRH_DQ_READBACK_EVIDENCE_V1",
    "complete_evidence_state": "READY_FOR_SEPARATE_AUTHORIZATION",
    "write_authorized_in_dq020": false,
    "mig010_authorization_reusable": false
  },
  "authority": {
    "canonical_schema_override": false,
    "financial_truth": false,
    "storage": false,
    "network": false,
    "financial_write": false,
    "repair_write": false
  },
  "privacy": {
    "public_data": "INDEPENDENTLY_GENERATED_SYNTHETIC_ONLY",
    "public_telemetry_allowlist": ["schema", "version", "scan_hash", "record_count", "issue_count", "reason_count", "status", "reason_code"],
    "rows_or_amounts_in_public_telemetry": false,
    "private_ids_in_public_telemetry": false
  },
  "cost": {
    "mode": "FREE_ONLY",
    "external_provider_required": false
  }
}
