{
  "schema": "PRH_PRIVACY_PRESENTATION_V1",
  "version": "1.0.0",
  "roadmap_id": "PRIV-080",
  "modes": ["NORMAL", "MASKED", "DEMO", "ZEN"],
  "default_mode": "NORMAL",
  "invalid_mode_fail_safe": "MASKED",
  "security_boundary": false,
  "authorization_boundary": false,
  "preference": {
    "schema": "PRH_PRIVACY_MODE_PREFERENCE_V1",
    "storage_key": "prh.privacyPresentation.mode.v1",
    "stored_fields": ["schema", "version", "mode"],
    "url_parameter": "privacy",
    "url_override_priority": true,
    "financial_payload_allowed": false,
    "query_payload_allowed": false,
    "filter_payload_allowed": false,
    "private_identifier_allowed": false
  },
  "provenance": {
    "private": "PRIVATE_AUTHORIZED_PRESENTATION",
    "synthetic": "PUBLIC_SYNTHETIC",
    "demo_requires_synthetic": true,
    "mixed_private_synthetic_allowed": false
  },
  "sensitive_key_exact": [
    "amount", "amount_minor", "value", "value_minor", "income", "income_minor", "expense", "expense_minor",
    "cash_flow", "cash_flow_minor", "budget", "budget_minor", "balance", "balance_minor", "savings", "savings_minor",
    "net_worth", "net_worth_minor", "variance", "variance_minor", "reference_minor", "delta_minor", "target_minor",
    "transaction_id", "account_id", "account_name", "category_id", "category_name", "member_id", "member_name",
    "project_id", "project_name", "counterparty", "description", "note", "comment", "merchant", "tag", "tags"
  ],
  "sensitive_key_suffixes": ["_amount", "_amount_minor", "_value", "_value_minor", "_balance", "_balance_minor", "_minor"],
  "safe_structural_keys": [
    "schema", "version", "contract_version", "state", "status", "reason", "kind", "type", "currency",
    "count", "total_count", "row_count", "alert_count", "configured", "available", "partial", "synthetic_only",
    "provenance", "financial_truth_policy", "mode", "source"
  ],
  "transform": {
    "MASKED": {
      "sensitive_leaf_replacement": null,
      "array_sensitive_item_policy": "DROP",
      "preserve_structure": true,
      "preserve_currency": true,
      "financial_truth_surface": false
    },
    "ZEN": {
      "sensitive_leaf_replacement": null,
      "array_sensitive_item_policy": "DROP",
      "preserve_structure": false,
      "safe_keys_only": true,
      "financial_truth_surface": false
    },
    "DEMO": {
      "source": "PUBLIC_SYNTHETIC",
      "private_input_allowed": false,
      "financial_truth_surface": false
    },
    "NORMAL": {
      "source": "PRIVATE_AUTHORIZED_PRESENTATION",
      "financial_truth_surface": true
    }
  },
  "telemetry_allowlist": ["schema", "version", "mode", "source", "decision", "reason", "field_count", "suppressed_count", "synthetic_only"],
  "authority": {
    "financial_truth": false,
    "financial_write": false,
    "authorization": false,
    "authentication": false,
    "canonical_mutation": false,
    "query_execution": false,
    "query_mutation": false,
    "storage": false,
    "network": false,
    "deployment": false
  },
  "free_only": true
}
